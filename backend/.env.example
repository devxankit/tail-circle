# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# ─── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/tailcircle

# ─── Auth / JWT ─────────────────────────────────────────
# Use long random strings in production; ACCESS and REFRESH MUST differ.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP (phone login) ──────────────────────────────────
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=4
# Anti-abuse limits (per phone number):
#   OTP_COOLDOWN_SECONDS — minimum gap between two OTP requests
#   OTP_MAX_PER_HOUR     — how many OTPs a number can request per hour
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# ─── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins. In production this must NOT
# contain localhost (startup guard will refuse to boot).
CORS_ORIGIN=http://localhost:5173,https://tail-circle-nine.vercel.app

# ─── Rate limiting ──────────────────────────────────────
# General API traffic. A logged-in dashboard fans out many calls per screen,
# so this needs headroom well above a single page load.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth / OTP endpoints only — separate and much tighter, because this is the
# guard against password and OTP brute force. Raise it temporarily for manual
# testing (logging into several vendor panels exceeds 10 quickly), but keep it
# low in production.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── Cloudinary (media uploads) ─────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=tailcircle

# ─── Upload limits ──────────────────────────────────────
# Max file size in megabytes
MAX_FILE_SIZE_MB=10

# ─── SMS India Hub (OTP delivery) ───────────────────────
# When false (or in development), OTPs are logged to the terminal instead of
# sent. The OTP message body must match the DLT-registered template exactly.
SMS_INDIA_ENABLED=false
SMS_INDIA_BASE_URL=http://cloud.smsindiahub.in/vendorsms/pushsms.aspx
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_PE_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
SMS_INDIA_HUB_GWID=2

# ─── Razorpay (payments) ────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set after configuring the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# ─── Firebase (Admin SDK · FCM push only) ───────────────
# Live chat runs on Socket.IO; Firebase is used only for push notifications.
FIREBASE_PROJECT_ID=
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Redis (caching · rate limits · socket adapter) ─────
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=tc:

# ─── LiveKit (self-hosted video consultations) ──────────
# Full setup guide: backend/livekit/README.md
#
# These MUST match the keys in backend/livekit/livekit.yaml — a mismatch
# rejects every token at connect time with an opaque connection error.
#   node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"  # key
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  # secret
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LIVEKIT_URL      — what BROWSERS dial. Must be public wss:// in production.
# LIVEKIT_HTTP_URL — what THIS SERVER dials for the Room API. Loopback is fine.
# Handing a phone a localhost URL is the most common self-host failure; the
# production startup guard refuses to boot on it.
#
# ⚠ Both carry LiveKit's signalling port. If you change LIVEKIT_PORT in
#   backend/livekit/.env, update LIVEKIT_HTTP_URL here (and VITE_LIVEKIT_URL in
#   frontend/.env) to match. In production LIVEKIT_URL points at nginx on 443,
#   so it only changes if you move nginx itself.
#   The LiveKit ports themselves live in backend/livekit/.env — see
#   backend/livekit/README.md for the full list and the firewall table.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880

# How long a participant join token stays valid.
LIVEKIT_TOKEN_TTL=2h
# LiveKit → API webhooks carry the authoritative join/leave timestamps that
# overage billing is computed from. Disable only for local UI work.
LIVEKIT_WEBHOOK_ENABLED=true

# ─── TURN / STUN (WebRTC relay) ─────────────────────────
# Required in production: without a relay, calls fail on strict-NAT networks
# (most Indian mobile carriers). TURN_SECRET must match coturn's
# static-auth-secret — the API derives time-limited credentials from it.
TURN_URLS=
TURN_SECRET=
STUN_URLS=stun:stun.l.google.com:19302

# ─── Video consultation behaviour ───────────────────────
# How early either party may join before the slot starts.
CONSULT_JOIN_LEAD_MINUTES=10
# Grace after the scheduled end during which the room stays joinable.
CONSULT_JOIN_GRACE_MINUTES=15
# How long the callee rings before the call is marked missed.
CONSULT_RING_TIMEOUT_MS=45000
