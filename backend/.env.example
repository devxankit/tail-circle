# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# ─── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/tailcircle

# ─── Auth / JWT ─────────────────────────────────────────
# Use long random strings in production; ACCESS and REFRESH MUST differ.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP (phone login) ──────────────────────────────────
OTP_EXPIRES_MINUTES=5
OTP_LENGTH=4
# Anti-abuse limits (per phone number):
#   OTP_COOLDOWN_SECONDS — minimum gap between two OTP requests
#   OTP_MAX_PER_HOUR     — how many OTPs a number can request per hour
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# ─── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed origins. In production this must NOT
# contain localhost (startup guard will refuse to boot).
CORS_ORIGIN=http://localhost:5173,https://tail-circle-nine.vercel.app

# ─── Rate limiting ──────────────────────────────────────
# General API traffic. A logged-in dashboard fans out many calls per screen,
# so this needs headroom well above a single page load.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth / OTP endpoints only — separate and much tighter, because this is the
# guard against password and OTP brute force. Raise it temporarily for manual
# testing (logging into several vendor panels exceeds 10 quickly), but keep it
# low in production.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ─── Cloudinary (media uploads) ─────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=tailcircle

# ─── Upload limits ──────────────────────────────────────
# Max file size in megabytes
MAX_FILE_SIZE_MB=10

# ─── SMS India Hub (OTP delivery) ───────────────────────
# When false (or in development), OTPs are logged to the terminal instead of
# sent. The OTP message body must match the DLT-registered template exactly.
SMS_INDIA_ENABLED=false
SMS_INDIA_BASE_URL=http://cloud.smsindiahub.in/vendorsms/pushsms.aspx
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_PE_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
SMS_INDIA_HUB_GWID=2

# ─── Razorpay (payments) ────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set after configuring the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# ─── Firebase (Admin SDK · FCM push only) ───────────────
# Live chat runs on Socket.IO; Firebase is used only for push notifications.
FIREBASE_PROJECT_ID=
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Redis (caching · rate limits · socket adapter) ─────
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=tc:

# ─── TURN / STUN (video consult WebRTC relay) ───────────
# Video consultations are direct browser-to-browser WebRTC (P2P) signalled
# over Socket.IO — see backend/src/sockets/index.js and
# backend/src/services/webrtcSignal.service.js. This section is only the
# relay fallback for strict-NAT networks (most Indian mobile carriers).
# Full setup guide: backend/turn/README.md
#
# TURN_SECRET must match coturn's static-auth-secret in backend/turn/.env —
# the API derives time-limited TURN credentials from it. Required in
# production: the startup guard refuses to boot with TURN_URLS empty.
TURN_URLS=
TURN_SECRET=
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:global.stun.twilio.com:3478

# ─── Video consultation behaviour ───────────────────────
# How early either party may join before the slot starts.
CONSULT_JOIN_LEAD_MINUTES=10
# Grace after the scheduled end during which the room stays joinable.
CONSULT_JOIN_GRACE_MINUTES=15
# How long the callee rings before the call is marked missed.
CONSULT_RING_TIMEOUT_MS=45000
