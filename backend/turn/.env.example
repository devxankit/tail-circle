# coturn (TURN/STUN relay) configuration.
#
#   cp .env.example .env
#
# coturn does not read env vars directly — these are passed as CLI flags by
# docker-compose.turn.yml, which override the matching keys in
# coturn/turnserver.conf.

# ─── Domain ───────────────────────────────────────────────────────────────
# Used to template turnserver.conf's TLS cert paths.
TURN_DOMAIN=turn.example.com

# ─── coturn ───────────────────────────────────────────────────────────────
# The VM's PUBLIC IP. coturn advertises this as the relay address; an internal
# address here produces ICE candidates no client can reach.
TURN_PUBLIC_IP=

# Shared secret for time-limited TURN credentials. Must match TURN_SECRET in
# backend/.env so the API derives credentials coturn will accept.
TURN_SECRET=

# TURN listeners and relay range — open these in the firewall too.
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
