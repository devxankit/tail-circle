# LiveKit media-plane configuration.
#
#   cp .env.example .env
#
# LiveKit does NOT expand ${VAR} inside livekit.yaml — every value below is
# read by LiveKit itself as an environment variable. The naming rule is the
# config path, upper-cased and underscore-joined (rtc.tcp_port →
# LIVEKIT_RTC_TCP_PORT), so anything in LiveKit's config schema can be set here.
#
# Check what a configuration will bind before starting it:
#   docker compose -f docker-compose.livekit.yml run --rm livekit ports

# ─── Keys ─────────────────────────────────────────────────────────────────
# LiveKit reads the pair from LIVEKIT_KEYS ("<key>: <secret>"). The compose
# file builds it from the two values below, which MUST match
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET in backend/.env — a mismatch rejects
# every participant token at connect time with an opaque error.
#
#   node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"   # key
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # secret
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Ports ────────────────────────────────────────────────────────────────
# Change these to move LiveKit off the defaults. Whatever you set here must
# also be opened in the firewall and reflected in nginx (LIVEKIT_PORT) — see
# README.md.
#
# Signalling: WebSocket + HTTP. nginx proxies wss://<domain> to this.
LIVEKIT_PORT=7880
# WebRTC over TCP — the fallback when UDP is blocked.
LIVEKIT_RTC_TCP_PORT=7881
# WebRTC media over UDP. Widen the range for more concurrent calls; a rough
# guide is ~2 ports per participant.
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=50100

# true on any cloud VM — LiveKit must advertise its public address in ICE
# candidates. false only when clients run on the same machine as the server.
LIVEKIT_RTC_USE_EXTERNAL_IP=true

# ─── Webhooks ─────────────────────────────────────────────────────────────
# Where LiveKit POSTs join/leave events. Must be reachable from the container.
LIVEKIT_WEBHOOK_URLS=https://api.example.com/api/consults/webhook/livekit

# ─── Domains ──────────────────────────────────────────────────────────────
# Used to template nginx/livekit.conf and coturn/turnserver.conf.
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com

# ─── coturn ───────────────────────────────────────────────────────────────
# The VM's PUBLIC IP. coturn advertises this as the relay address; an internal
# address here produces ICE candidates no client can reach.
TURN_PUBLIC_IP=

# Shared secret for time-limited TURN credentials. Must match TURN_SECRET in
# backend/.env so the API derives credentials coturn will accept.
TURN_SECRET=

# TURN listeners and relay range — open these in the firewall too.
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
